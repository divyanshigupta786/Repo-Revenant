# RepoRevenant Environment Configuration

# Backend API Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Local Open-Weight Inference (Ollama / vLLM / Local OpenAI compatible)
MODEL_PROVIDER=local_open_weight
MODEL_NAME=Llama-3-8B-RepoRevenant
LOCAL_LLM_ENDPOINT=http://127.0.0.1:11434

# Optional: Cloud Accelerated Inference (If authorized by developer)
GEMINI_API_KEY=

# Sandbox Security Controls
TEST_TIMEOUT_SECONDS=30
MAX_INSPECTED_FILE_SIZE_KB=512
ENABLE_ISOLATED_SANDBOXES=true

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
